LIVE_MODE=true
TESTNET=true
STUB_MODE=false
PAPER_MODE=false

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_CATEGORY=linear
BYBIT_SYMBOL=BTCUSDT

# Optional sizing override (YAML is source of truth)
ORDER_SIZE_USDT=

# Execution / WS / Safety
DRY_RUN=false
ENABLE_PRIVATE_WS=false
FEE_ASSUME_ENTRY=auto   # auto|maker|taker
FEE_ASSUME_EXIT=taker   # maker|taker
POSITION_MODE=ONEWAY    # ONEWAY|HEDGE
ACCOUNT_TYPE=UNIFIED    # UNIFIED|CONTRACT
SKIP_SMOKE_CANCEL=false
DEBUG_OPEN_ORDERS=false

# Reporting
TRADE_LEDGER_ENABLED=true
TRADE_LEDGER_FORMATS=csv,jsonl

# Operational override
TIME_STOP_SEC=900
