LIVE_MODE=true              # 실제 거래 경로 활성화(안전상 TESTNET과 함께 사용 권장)
TESTNET=true                # Bybit 테스트넷 사용
STUB_MODE=false             # 스텁 데이터 소스 사용(오프라인/리플레이)
PAPER_MODE=false            # 페이퍼 모드(체결 시뮬레이션)

BYBIT_API_KEY=              # Bybit API 키(비워두면 일부 API 호출을 생략)
BYBIT_API_SECRET=           # Bybit API 시크릿
BYBIT_CATEGORY=linear       # 선물 카테고리: linear|inverse|spot
BYBIT_SYMBOL=BTCUSDT        # 기본 심볼(유니버스/디스커버리가 꺼진 경우 사용)

# Optional sizing override (YAML is source of truth)
ORDER_SIZE_USDT=            # (선택) 고정 공사이즈 USDT(없으면 YAML 리스크/레버리지로 산출)

# Execution / WS / Safety
DRY_RUN=false                # true면 주문 전송을 생략(로그만 기록)
ENABLE_PRIVATE_WS=false      # 프라이빗 WS(주문/체결/포지션) 수집
FEE_ASSUME_ENTRY=auto        # 엔트리 수수료 가정: auto|maker|taker
FEE_ASSUME_EXIT=taker        # 이그짓 수수료 가정: maker|taker
POSITION_MODE=ONEWAY         # 포지션 모드: ONEWAY|HEDGE
ACCOUNT_TYPE=UNIFIED         # 계정 타입: UNIFIED|CONTRACT
SKIP_SMOKE_CANCEL=false      # 스모크 취소 경로 비활성화
DEBUG_OPEN_ORDERS=false      # 열린 주문 상세 로그 토글

# Reporting
TRADE_LEDGER_ENABLED=true    # 리포팅(트레이드 레저) 출력 활성화
TRADE_LEDGER_FORMATS=csv,jsonl # 출력 포맷: csv,jsonl

# Operational override
TIME_STOP_SEC=900            # 하드 타임스탑(초) 운영 오버라이드
