LIVE_MODE=true
TESTNET=true
STUB_MODE=false
PAPER_MODE=false

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_CATEGORY=linear
BYBIT_SYMBOL=BTCUSDT

# ── Risk & Sizing ────────────────────────────────────────────────────
LEVERAGE=7
LEVERAGE_DEFAULT=7
MAX_ALLOC_PCT=0.02
MIN_FREE_BALANCE_USDT=50
ORDER_SIZE_USDT=
TOTAL_BUDGET_USDT=

# ── Execution / Slippage ─────────────────────────────────────────────
SLIPPAGE_GUARD_PCT=0.001
DRY_RUN=false
ENABLE_PRIVATE_WS=false

# ── Runtime toggles & discovery ──────────────────────────────────────
TIME_STOP_SEC=900                 # 하드 타임스탑(초)
ENABLE_PRIVATE_WS=false          # 프라이빗 WS (order/execution/position)
DISCOVER_SYMBOLS=true            # 디스커버리 사용 여부(기본 true)
CONSENSUS_TICKS=5                # 진입 전 관찰 틱 수
NO_TRADE_SLEEP_SEC=5             # 미진입 시 대기 시간
LOOP_IDLE_SEC=1                  # 회전 간 간격
EXIT_KEY=q
