LIVE_MODE=true
TESTNET=false
STUB_MODE=false
PAPER_MODE=false

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_CATEGORY=linear
BYBIT_SYMBOL=BTCUSDT

# Risk & Sizing (more conservative on mainnet)
LEVERAGE=5
LEVERAGE_DEFAULT=5
