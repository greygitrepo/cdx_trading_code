LIVE_MODE=true
TESTNET=false
STUB_MODE=false
PAPER_MODE=false

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_CATEGORY=linear
BYBIT_SYMBOL=BTCUSDT

# Optional sizing override (use YAML normally)
ORDER_SIZE_USDT=

# Execution / WS / Safety
DRY_RUN=true
ENABLE_PRIVATE_WS=false
FEE_ASSUME_ENTRY=auto
FEE_ASSUME_EXIT=taker
POSITION_MODE=ONEWAY
ACCOUNT_TYPE=UNIFIED
SKIP_SMOKE_CANCEL=true
DEBUG_OPEN_ORDERS=false

# Reporting
TRADE_LEDGER_ENABLED=true
TRADE_LEDGER_FORMATS=csv,jsonl

# Operational override
TIME_STOP_SEC=900
