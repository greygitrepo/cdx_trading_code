LIVE_MODE=true
TESTNET=false
STUB_MODE=false
PAPER_MODE=false

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_SYMBOL=BTCUSDT

# Optional order sizing overrides (YAML single-source by default)
ORDER_SIZE_USDT=

# Execution
SLIPPAGE_GUARD_PCT=0.0008
DRY_RUN=true
SKIP_SMOKE_CANCEL=true
ENABLE_PRIVATE_WS=false

# Time stop (operational override)
TIME_STOP_SEC=900
